# =============================================
# PH Holdings Sovereign UI - .gitignore
# =============================================

# === Build Artifacts ===
build/
!build/
build/*
!build/darwin/
build/darwin/*
!build/darwin/Info.plist
!build/darwin/Info.dev.plist
dist/
*.exe
*.dll
*.dylib
*.so
*.app

# === Dependencies ===
node_modules/
frontend/node_modules/

# === Environment & Secrets ===
.env
.env.bak-*
.env.local
.env.production
# .env.example is committed (template without secrets)

# === Databases ===
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# === IDE / Editor ===
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# === OS Files ===
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# === Logs ===
*.log
*.out
crash_log.*

# === Test Artifacts ===
coverage.out
test-results/
playwright-report/
*.test.exe

# === Vite Temp Files ===
*.timestamp-*.mjs

# === Generated Output ===
exports/intelligence/
batch_output/
test_output/
temp/

# === Archives & Packages ===
*.zip
*.7z
*.tar.gz
*.tar
*.rar
deploy_package/AsymmFlow_Deploy_*/
deploy_package/AsymmFlow.app/
deploy_package/AsymmFlowPHTrading.app/
deploy_package/AsymmFlow.exe
deploy_package/.env
deploy_package/ph_holdings.db
deploy_package/data/ph_holdings.db

# === Temporary Files ===
*.tmp
*.bak
*.backup
nul

# === Business Documents (NEVER commit) ===
Bank_Statements/
Costing_Sheets/
Offers*/

# === Mac Dev Setup (local only) ===
mac_dev_setup/

# === AI Tool Config (local only) ===
.agent/
.claude/
.gitnexus
.opencode/
opencode.json
