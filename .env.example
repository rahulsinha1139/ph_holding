# PH Holdings Sovereign UI - Environment Configuration
# Copy this to .env and fill in your values

# ═══════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════
# Option 1: Asymmetrica self-hosted Postgres (recommended as of April 2026).
# This is the new default — replaces the Supabase cloud dependency.
# Postgres 16 with TLS 1.3 on the Asymmetrica VPS (5.223.95.178:5432).
# See memory/asymm_db_supabase_selfhost.md for full operations notes.
DATABASE_URL=postgresql://postgres:<ask-commander>@5.223.95.178:5432/asymmflow?sslmode=require

# Option 2: Render.com PostgreSQL (legacy)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 3: Supabase cloud (deprecated, kept for rollback)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key
# SUPABASE_STORAGE_BUCKET=reports

# ═══════════════════════════════════════════════════════════
# ASYMMETRICA RUNTIME (OCR + kernels, formerly Fly.io)
# ═══════════════════════════════════════════════════════════
# The Asymmetrica Runtime (asymm-engine) is now hosted on the VPS at
# https://api.asymmetrica.ai/engine (Caddy reverse-proxies to asymm-engine:8090).
# This replaces the retired https://asymmetrica-runtime.fly.dev deployment.
# The service requires a bearer-style token on every request, sent as the
# X-Asymm-Service-Token header.
ASYMM_ENGINE_URL=https://api.asymmetrica.ai/engine
ASYMM_SERVICE_TOKEN=<ask-commander-for-token>

# Legacy env vars (still honored as a fallback during the transition):
# FLY_OCR_URL=https://asymmetrica-runtime.fly.dev  # DEPRECATED - use ASYMM_ENGINE_URL
# ASYMM_API_KEY=<token>  # DEPRECATED - use ASYMM_SERVICE_TOKEN

# ═══════════════════════════════════════════════════════════
# AI SERVICES
# ═══════════════════════════════════════════════════════════
MISTRAL_API_KEY=your-mistral-api-key

# ═══════════════════════════════════════════════════════════
# AZURE / MICROSOFT GRAPH (Optional)
# ═══════════════════════════════════════════════════════════
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ═══════════════════════════════════════════════════════════
# ONEDRIVE PATHS (Optional - for file watcher)
# ═══════════════════════════════════════════════════════════
# ONEDRIVE_RFQ_PATH=C:/Users/YourName/OneDrive/PH Trading/RFQs
# ONEDRIVE_EH_PATH=C:/Users/YourName/OneDrive/PH Trading/E+H Data
# ONEDRIVE_OFFERS_PATH=C:/Users/YourName/OneDrive/PH Trading/Offers
# ONEDRIVE_INVOICES_PATH=C:/Users/YourName/OneDrive/PH Trading/Invoices

# ═══════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════
LOG_LEVEL=info
DEBUG_MODE=false
ENABLE_FILE_WATCHER=true
ENABLE_AUTO_BACKUP=false

# ═══════════════════════════════════════════════════════════
# API SERVER (for web deployment)
# ═══════════════════════════════════════════════════════════
# PORT=8080
# ALLOWED_ORIGINS=https://your-app.onrender.com,http://localhost:5173
# RATE_LIMIT_PER_MINUTE=60
